# Binance Futures API (읽기+거래 권한, IP 제한 권장)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Bot
TG_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# ── MCP 서버 - Vultr SSH 접속 정보 ──────────────────────────
VULTR_HOST=123.456.789.0         # Vultr 서버 IP
VULTR_PORT=22                    # SSH 포트 (기본 22)
VULTR_USER=root                  # SSH 사용자명

# 인증 방식 1: SSH 키 (권장)
VULTR_KEY_PATH=/path/to/your/ssh/key

# 인증 방식 2: 비밀번호 (키가 없을 때만)
# VULTR_PASSWORD=your_password

# ── MCP 서버 - 원격 경로 ─────────────────────────────────────
REMOTE_DB_PATH=/root/ATLAS/state/atlas_v2.db
REMOTE_LOG_DIR=/root/ATLAS/logs

# ── MCP 서버 - 성과 계산 기준 ────────────────────────────────
INITIAL_CAPITAL=1000   # MDD% 계산 시 기준 자본 ($)
