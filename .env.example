# Binance Spot API (읽기+거래 권한, IP 제한 권장)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Bot
TG_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# ── MCP 서버 - Vultr SSH 접속 정보 ──────────────────────────
VULTR_HOST=123.456.789.0         # Vultr 서버 IP
VULTR_PORT=22                    # SSH 포트 (기본 22)
VULTR_USER=root                  # SSH 사용자명

# 인증 방식 1: SSH 키 (권장)
VULTR_KEY_PATH=/path/to/your/ssh/key

# 인증 방식 2: 비밀번호 (키가 없을 때만)
# VULTR_PASSWORD=your_password

# ── MCP 서버 - 원격 경로 ─────────────────────────────────────
REMOTE_DIR=/root/atlas_spot              # 서버의 봇 설치 경로
REMOTE_DB_PATH=/root/atlas_spot/state/atlas_spot.db
REMOTE_LOG_DIR=/root/atlas_spot/logs
# 미등록 호스트 자동 신뢰는 기본 거부(MITM 방어). 1일 때만 허용.
MCP_SSH_TRUST_NEW=

# ── 성과 계산 기준 ────────────────────────────────────────────
INITIAL_CAPITAL=1000   # MDD% 계산 시 기준 자본 ($)

# ── 대시보드 ─────────────────────────────────────────────────
DASH_PASSWORD=atlas2026        # 대시보드 접속 비밀번호 (반드시 변경)
DASH_REFRESH_SEC=60            # 자동 갱신 주기 (초)
# DB_FILE은 **파일이 실제로 있을 때만** 우선 적용된다(없으면 경고 후 정식 경로 폴백).
# 경로가 서로 어긋나면 리포트가 조용히 빈 데이터가 된다 — 위 REMOTE_DB_PATH와 맞출 것.
DB_FILE=/root/atlas_spot/state/atlas_spot.db

# ⚠️ 대시보드의 "봇 시작"이 쓰는 기동 인자. **비워두면 인자 없이(라이브 모드,
#    기본 전략) 재기동**되므로, dry-run으로 운용 중이라면 반드시 명시할 것.
BOT_START_ARGS=--strategies S3,S4,S5,S6

# ── 월간 WFO 자동화 ──────────────────────────────────────────
WFO_AUTO_REOPT=1               # WFO 판정 미달 시 재최적화(제안) 트리거
# WFO_REOPT_ALWAYS=1           # 전 전략 PASS여도 재최적화 실행
