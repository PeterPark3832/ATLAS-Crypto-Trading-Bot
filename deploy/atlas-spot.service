# ATLAS Spot Trading Bot — systemd 유닛
# =====================================
# 설치:
#   sudo cp deploy/atlas-spot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-spot
#
# 동작 원리:
#   - Restart=on-failure: 크래시(비정상 종료) 시에만 10초 후 자동 재기동.
#   - 킬스위치(/tmp/ATLAS_SPOT_STOP)가 있으면 봇이 기동 즉시 정상 종료(exit 0)
#     하므로 재시작 루프에 빠지지 않는다 (atlas_spot_main.py 기동 가드).
#   - 정지: systemctl stop atlas-spot  (또는 킬스위치 touch 후 자연 종료 대기)
#   - 재가동: 킬스위치 삭제 후 systemctl start atlas-spot
#
# 주의: 인자 변경(--dry-run 등) 시 이 파일과 대시보드 .env의 BOT_START_ARGS를
#       함께 수정해 두 기동 경로가 항상 같은 구성으로 뜨게 유지한다.
#
# 로그: 봇은 자체 FileHandler로 logs/에 기록하지만, print 출력(유니버스 스캔 등)은
#       stdout으로만 나간다. 대시보드가 spot_main.log를 파싱해 봇 상태·레짐을
#       표시하므로 stdout/stderr도 같은 파일에 append 한다 (systemd 240+ 필요).

[Unit]
Description=ATLAS Spot Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/atlas_spot
ExecStart=/usr/bin/python3 -u atlas_spot_main.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/root/atlas_spot/logs/spot_main.log
StandardError=append:/root/atlas_spot/logs/spot_main.log

[Install]
WantedBy=multi-user.target
