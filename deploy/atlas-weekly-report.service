# ATLAS Spot — 주간 성과 리포트 (oneshot)
# ========================================
# 설치:
#   sudo cp deploy/atlas-weekly-report.service \
#           deploy/atlas-weekly-report.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-weekly-report.timer
#
# 수동 1회 실행: sudo systemctl start atlas-weekly-report.service
#
# 배경: 이 리포트는 docstring에 crontab 한 줄로만 적혀 있었고 서버 어디에도
#       등록돼 있지 않았다(crontab 비어 있음). 즉 한 번도 자동 실행된 적이
#       없다. WFO 리포트와 같은 systemd 타이머 방식으로 통일한다.
#
# 자원: DB 조회 + 텔레그램 전송뿐이라 가볍다(수 MB). 그래도 RAM 951MB
#       서버이므로 상한을 걸어 라이브 봇을 보호한다.

[Unit]
Description=ATLAS Spot Weekly Performance Report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/atlas_spot
ExecStart=/usr/bin/python3 -u weekly_report.py
Environment=PYTHONUNBUFFERED=1
MemoryMax=150M
CPUQuota=40%
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=600
StandardOutput=append:/root/atlas_spot/logs/weekly_report.log
StandardError=append:/root/atlas_spot/logs/weekly_report.log
